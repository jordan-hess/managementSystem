# No database or auth settings: this copy runs on an in-memory database
# built from Database/ at startup (lib/db/local/), and the role-select
# modal picks which demo user you are.

# leadOps workspace: the manager and reviewer are looked up by email.
LEADOPS_MANAGER_EMAIL=
LEADOPS_REVIEWER_EMAIL=
# Set to 'true' to show the mock leadOps tabs.
LEADOPS_MOCK_TABS=
